{
  "name": "Life Planner",
  "short_name": "Life Planner",
  "description": "Planificateur de vie, journal de bord et carnet manuscrit synchronisé avec Google Agenda.",
  "lang": "fr",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f6f5f2",
  "theme_color": "#0a0909",
  "icons": [
    { "src": "icons/planner-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/planner-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/logo.png", "sizes": "256x256", "type": "image/png" }
  ]
}
