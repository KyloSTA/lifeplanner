{
  "manifest_version": 3,
  "name": "Life Planner — Reddit, YouTube, Amazon et Facebook → Life Planner",
  "version": "1.8.0",
  "description": "Ajoute un bouton « Cerveau » aux posts Reddit, aux vidéos YouTube et aux produits Amazon (et « Activités » aux événements Facebook) ouverts depuis le Lanceur de Life Planner (ou dans leur app installée), pour les enregistrer comme note. Un bouton « ↩ Life Planner » en haut des pages ouvertes depuis le Lanceur ramène l'app à l'avant.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://kylosta.github.io/lifeplanner/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": ["http://localhost:5173/*", "https://kylosta.github.io/lifeplanner/*"],
      "js": ["back.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://new.reddit.com/*", "https://reddit.com/*"],
      "js": ["reddit.js"],
      "css": ["reddit.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.amazon.ca/*", "https://www.amazon.com/*", "https://www.amazon.fr/*", "https://amazon.ca/*", "https://amazon.com/*"],
      "js": ["amazon.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://facebook.com/*", "https://m.facebook.com/*"],
      "js": ["facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*", "https://kylosta.github.io/lifeplanner/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icon128.png" }
}
